# Explicit local demo: no claims of live AI or blockchain settlement.
AI_MODE=fixture
PAYMENT_MODE=simulation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
APP_URL=http://127.0.0.1:3000
CARDANO_NETWORK=preprod
BLOCKFROST_PROJECT_ID=
MANAGER_MNEMONIC=
RESEARCH_MNEMONIC=
RESEARCH_BACKUP_MNEMONIC=
MANAGER_WALLET_ADDRESS=
RESEARCH_WALLET_ADDRESS=
RESEARCH_BACKUP_WALLET_ADDRESS=
DATA_WALLET_ADDRESS=
REPORT_WALLET_ADDRESS=
MAX_AGENT_DEPTH=3
# Optional registry: read-only adapter; inspect your node's OpenAPI before setting.
MASUMI_REGISTRY_URL=
MASUMI_API_KEY=

# Native Masumi V2 nodes. masumi:prepare generates local secrets in .env.local.
# Leave MASUMI_NODE_URL blank until registrations are confirmed.
MASUMI_NODE_URL=
MASUMI_MANAGER_NODE_URL=http://127.0.0.1:3002/api/v1
MASUMI_RESEARCH_NODE_URL=http://127.0.0.1:3003/api/v1
MASUMI_RESEARCH_BACKUP_NODE_URL=http://127.0.0.1:3004/api/v1
MASUMI_MANAGER_API_KEY=
MASUMI_RESEARCH_API_KEY=
MASUMI_RESEARCH_BACKUP_API_KEY=
MASUMI_DB_PASSWORD=
MASUMI_ENCRYPTION_KEY=
MASUMI_AGENT_IDS='{}'
MASUMI_ESCROW_ENABLED=false
