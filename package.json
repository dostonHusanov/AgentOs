{
  "name": "agentos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "pretest": "npm run mcp:build",
    "mcp:build": "tsc -p mcp/tsconfig.json",
    "mcp:start": "node dist/mcp/server.js",
    "mcp:test": "npm run mcp:build && node --import tsx --test tests/mcp.test.ts",
    "mcp:smoke": "npm run mcp:build && node --import tsx scripts/mcp-smoke.ts",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "npm run mcp:build && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "demo:check": "node --import tsx scripts/health-check.ts",
    "agents:register": "node --import tsx scripts/register-agents.ts",
    "wallet:check": "node --import tsx scripts/fund-demo-wallet.ts",
    "test:integration": "node --import tsx scripts/smoke-test.ts",
    "format": "prettier --write app components lib types scripts tests mcp *.json *.ts *.mjs",
    "format:check": "prettier --check app components lib types scripts tests mcp *.json *.ts *.mjs",
    "demo:live": "node --import tsx scripts/live-demo.ts",
    "setup": "node --import tsx scripts/setup.ts",
    "setup:live": "node --import tsx scripts/setup.ts --live",
    "wallet:sync": "node --import tsx scripts/sync-wallet-addresses.ts",
    "ai:check": "node --import tsx scripts/ai-check.ts",
    "masumi:prepare": "node --import tsx scripts/masumi-prepare.ts",
    "masumi:start": "node --import tsx scripts/masumi-prepare.ts --start",
    "masumi:check": "node --import tsx scripts/masumi-check.ts",
    "escrow:reconcile": "node --import tsx scripts/escrow-reconcile.ts",
    "masumi:bootstrap": "node --import tsx scripts/masumi-bootstrap.ts",
    "masumi:enable": "node --import tsx scripts/masumi-enable.ts"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@x402/cardano": "latest",
    "@x402/core": "latest",
    "@x402/fetch": "latest",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "pdfkit": "0.20.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "0.17.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
